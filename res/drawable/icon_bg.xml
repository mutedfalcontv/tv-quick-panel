<?xml version="1.0" encoding="utf-8"?>
<!--
  Round glass button for the header actions (Home, gear). Same fill, border and
  focus ring as a Liquid Glass tile, so the D-pad highlight never changes
  language between the header and the grid.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#52FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#5CFFFFFF" />
        </shape>
    </item>
</selector>
