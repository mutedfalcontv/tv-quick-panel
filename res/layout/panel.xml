<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick panel, glass variant A: a frosted sheet on the right edge, matching the
  launcher's centred dock.

  Geometry is the approved mockup at half scale (the TV runs 320dpi, so 1dp = 2px
  of the 1920x1080 mockup): 332dp sheet, 52dp tiles, 10dp tile corners, 16dp
  sheet corners. Type follows glass.json: light display clock, 0.10em uppercase
  captions, no accent colour anywhere.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/dim_bg">

    <!-- Wallpaper stays visible on the left; the sheet only owns the right third. -->
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="66" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="34"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#99F5F5F7"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:includeFontPadding="false"
                    android:text="" />

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFF5F5F7"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="false"
                    android:text="" />
            </LinearLayout>

            <ImageView
                android:id="@+id/home"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                android:background="@drawable/icon_bg"
                android:contentDescription="@string/home"
                android:focusable="true"
                android:clickable="true" />

            <ImageView
                android:id="@+id/gear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="8dp"
                android:src="@drawable/ic_gear"
                android:background="@drawable/icon_bg"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/tile_inputs"
                android:focusedByDefault="true"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/tile_inputs" />

            <TextView
                android:id="@+id/tile_display"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/tile_display" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tile_sound"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/tile_sound" />

            <TextView
                android:id="@+id/tile_wifi"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/tile_wifi" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tile_bluetooth"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/tile_bluetooth" />

            <TextView
                android:id="@+id/tile_accessibility"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="@string/tile_accessibility" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/hint_panel"
            android:textColor="#7AF5F5F7"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12" />
    </LinearLayout>
</LinearLayout>
